# Supabase Core Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_PROJECT_ID=your-project-id
JWT_SECRET=your-jwt-secret

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_BUCKET=media
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# S3 Configuration for Supabase Storage
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-3
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-key

# Other configurations
NEXT_PUBLIC_URL=http://localhost:3000 

# Anthropic API (for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key

# EmailJS
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_CAREERS=your-template-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_CONTACT=your-template-id

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-ga-id

# Hugging Face
NEXT_PUBLIC_HUGGINGFACE_API_KEY=your-huggingface-key

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
NEXT_PUBLIC_SITE_URL=https://your-site.com
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
